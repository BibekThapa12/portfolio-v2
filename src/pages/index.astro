---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { profile, intro, projects, experience, education, skillGroups, domain, languages } from '../data/cv';
import Logo from '../components/Logo.astro';

const external = { target: '_blank', rel: 'noopener' };
const allTools = skillGroups.flatMap((g) => g.tools);
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/images/shots/*.png', { eager: true });
---

<Base
  title={`${profile.name}, ${profile.role.toLowerCase()}`}
  description="Bibek Thapa, full-stack developer in Jhapa, Nepal. React, TypeScript and Supabase. Builder of KhataERP."
>
  <canvas class="bg" aria-hidden="true"></canvas>

  <nav aria-label="Main" class="nav">
    <div class="wrap">
      <a class="name" href="#top">{profile.name}</a>
      <span>
        <a href="#projects">Projects</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </span>
    </div>
  </nav>

  <main id="top">
    <header class="wrap hero">
      <div>
        <h1 data-reveal>{profile.name}. <span>{profile.role}.</span></h1>
        <p class="lead" data-reveal>{intro}</p>
        <p class="actions" data-reveal>
          <a class="btn primary" href="#projects">See projects</a>
          <a class="btn" href={profile.cv} download>Download CV</a>
          <a class="btn" href={profile.github} {...external}>GitHub</a>
        </p>
      </div>
      <div class="monogram">
        <canvas aria-hidden="true"></canvas>
      </div>
    </header>

    <section id="projects">
      <div class="wrap">
        <div class="section-head">
          <h2 data-reveal>Projects</h2>
          <p data-reveal>Things I designed, built and shipped myself.</p>
        </div>
        <div class="projects">
          {projects.map((p) => (
            <article class="project" data-reveal>
              <div class="about">
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                <ul class="tags" aria-label="Built with">{p.stack.split(', ').map((t) => <li>{t}</li>)}</ul>
                <p class="actions">
                  {p.live && <a class="btn primary" href={p.live} {...external}>Visit {new URL(p.live).host}</a>}
                  {p.source && <a class={p.live ? 'btn' : 'btn primary'} href={p.source} {...external}>{p.live ? 'Source' : 'View source'}</a>}
                </p>
              </div>
              <a class="browser" data-cursor="View" href={p.live ?? p.source} {...external} aria-label={p.live ? `Visit ${new URL(p.live).host}` : `View the ${p.name} source on GitHub`}>
                <span class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.frame.bar}</span></span>
                <span class="browser-view">
                  <Image src={shots[`../assets/images/shots/${p.frame.file}.png`].default} alt={p.frame.alt} widths={[640, 1280]} sizes="(min-width: 900px) 620px, 100vw" />
                </span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="wrap">
        <div class="section-head">
          <h2 data-reveal>Experience</h2>
          <p data-reveal>Where I've worked, most recent first.</p>
        </div>
        <div class="journey-wrap">
        <span class="journey-rail" aria-hidden="true"><span class="journey-progress"></span></span>
        <ol class="journey">
          {experience.map((j) => (
            <li class:list={['step', { now: j.now }]} data-reveal>
              <span class="dot" aria-hidden="true"></span>
              <p class="when">{j.when}{j.now && <span class="now-label">Now</span>}</p>
              <h3>{j.title}</h3>
              <p class="org">{j.org}</p>
              {j.points && <ul>{j.points.map((p) => <li>{p}</li>)}</ul>}
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <section id="skills">
      <div class="wrap">
        <div class="section-head">
          <h2 data-reveal>Skills</h2>
          <p data-reveal>The tools I reach for to take an idea to production.</p>
        </div>
      </div>
      <div class="marquee" aria-hidden="true" data-reveal>
        <div class="marquee-track">
          {[...allTools, ...allTools].map((t) => <Logo name={t} />)}
        </div>
      </div>
      <div class="wrap">
        <div class="bento">
          {skillGroups.map((g) => (
            <article class="tile spot" data-reveal>
              <h3>{g.name}</h3>
              <p class="note">{g.note}</p>
              <ul class="logos">{g.tools.map((t) => <li><Logo name={t} /></li>)}</ul>
              <ul class="facts" aria-label={`${g.name} in KhataERP`}>{g.facts.map((x) => <li>{x}</li>)}</ul>
            </article>
          ))}
          <article class="tile spot" data-reveal>
            <h3>Domain</h3>
            <p class="note">Two years as a senior accountant, built into KhataERP</p>
            <ul class="domain">{domain.map((d) => <li>{d}</li>)}</ul>
          </article>
        </div>
        <p class="langs" data-reveal>
          <span class="langs-label">Languages</span>
          {languages.map((l) => <span class="lang">{l.name}{l.native !== l.name && <small lang={l.name === "Nepali" ? "ne" : "hi"}>{l.native}</small>}</span>)}
        </p>
      </div>
    </section>

    <section id="activity">
      <div class="wrap">
        <div class="section-head">
          <h2 data-reveal>GitHub activity</h2>
          <p class="gh-total" aria-live="polite" data-reveal>Loading live contributions from GitHub…</p>
        </div>
        <div class="tile gh" data-gh data-user={new URL(profile.github).pathname.slice(1)} data-reveal>
          <div class="gh-scroll">
            <div class="gh-months" aria-hidden="true"></div>
            <!-- empty cells hold the layout until the live data arrives -->
            <div class="gh-grid" role="img" aria-label="GitHub contributions calendar">{Array.from({ length: 371 }, () => <i></i>)}</div>
          </div>
          <div class="gh-foot">
            <span class="gh-legend" aria-hidden="true">Less {[0, 1, 2, 3, 4].map((l) => <i data-l={l}></i>)} More</span>
            <a class="btn" href={profile.github} {...external}>View on GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <section id="education">
      <div class="wrap edu">
        <div class="edu-side">
          <div class="section-head">
            <h2 data-reveal>Education</h2>
            <p data-reveal>Where the foundations came from.</p>
          </div>
          <div class="edu-stat" aria-hidden="true" data-reveal>
            <span class="edu-stat-value">{education[0].stat.value}</span>
            <span class="edu-stat-label">{education[0].stat.label}</span>
          </div>
        </div>
        <ol class="edu-rows">
          {education.map((e) => (
            <li class="edu-row" data-reveal data-stat={e.stat.value} data-stat-label={e.stat.label}>
              <span class="edu-year">{e.when}</span>
              <div class="edu-main">
                <h3>{e.title}</h3>
                <p>{e.school}</p>
              </div>
              <span class="edu-tag">{e.tag}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <div class="contact">
          <div>
            <h2 data-reveal>Let's build something.</h2>
            <p class="lead" data-reveal>I'm open to developer roles and freelance web projects. Tell me what you're working on.</p>
            <p class="actions" data-reveal>
              <a class="btn" href={profile.cv} download>Download CV</a>
              <a class="btn" href={profile.linkedin} {...external}>LinkedIn</a>
              <a class="btn" href={profile.github} {...external}>GitHub</a>
            </p>
          </div>
          <!-- Works without script as a GET form to mailto; contact.ts builds a cleaner link on submit -->
          <form class="compose" action={`mailto:${profile.email}`} method="get" data-compose data-email={profile.email} data-reveal>
            <div class="compose-bar" aria-hidden="true"><i></i><i></i><i></i><span>New message</span></div>
            <div class="compose-field"><span>To</span><b>{profile.email}</b></div>
            <fieldset class="compose-field compose-reason">
              <legend>Subject</legend>
              {['Job opportunity', 'Freelance project', 'Just saying hi'].map((s, i) => (
                <label><input type="radio" name="subject" value={s} checked={i === 0} /><span>{s}</span></label>
              ))}
            </fieldset>
            <label class="visually-hidden" for="compose-body">Your message</label>
            <textarea id="compose-body" name="body" rows="5" placeholder="Hi Bibek, I'd love your help with…"></textarea>
            <div class="compose-foot">
              <span class="compose-hint" aria-live="polite">Opens your email app with this filled in.</span>
              <button class="btn primary" type="submit">Send</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p>© {new Date().getFullYear()} {profile.name}, {profile.location}</p>
      <span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} {...external}>GitHub</a>
        <a href={profile.linkedin} {...external}>LinkedIn</a>
      </span>
    </div>
  </footer>
</Base>

<script>
  import '../scripts/motion';
  import { startCursor } from '../scripts/cursor';
  import { startMonogram } from '../scripts/monogram';
  import { startContact } from '../scripts/contact';
  import { startContributions } from '../scripts/contributions';

  const gh = document.querySelector<HTMLElement>('[data-gh]');
  if (gh) startContributions(gh);

  const compose = document.querySelector<HTMLFormElement>('[data-compose]');
  if (compose) startContact(compose);

  startCursor();
  const mono = document.querySelector<HTMLCanvasElement>('.monogram canvas');
  if (mono) startMonogram(mono);

  // The 3D background loads after the page is ready so it never delays the first paint.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.bg');
  const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  if (canvas) idle(() => import('../scripts/background').then((m) => m.startBackground(canvas)));
</script>
